+// Raw hi-res bytes of rows 7-16 (EA logo and copyright) on the boot menu,
+// whose UTILITIES / CHARACTER OPTIONS / PLAY A GAME choices are large bitmap
+// lettering. The menu flashes between two frames.
+constexpr std::uint64_t kBootMenuHashes[] = {0xd58be0fb62b670d5ULL, 0xf0a24cd95dc01824ULL};
+
+void DrawAppleOverlay(ImDrawList* draw, const ImVec2& topLeft, const ImVec2& size)
+{
+    if (!Enabled()) return;
+    static HgrTextScreen screen;
+    static std::uint64_t lastSignature = 0;
+    static std::vector<OverlayItem> items;
+    if (!screen.Scan())
+    {
+        items.clear();
+        lastSignature = 0;
+        return;
+    }
+    if (screen.Signature() != lastSignature)
+    {
+        items = BuildOverlay(screen);
+        lastSignature = screen.Signature();
+        if (std::getenv("DLRL_DUMP_TEXT"))
+        {
+            std::fputs("--- screen text ---\n", stderr);
+            for (int row = 0; row < HgrTextScreen::Rows; ++row)
+            {
+                std::string line;
+                for (int column = 0; column < HgrTextScreen::Columns; ++column)
+                {
+                    const HgrTextCell& cell = screen.Cell(column, row);
+                    line.push_back(!cell.known ? '?' : cell.inverse
+                        ? static_cast<char>(std::tolower(static_cast<unsigned char>(cell.ch == ' ' ? '_' : cell.ch)))
+                        : cell.ch);
+                }
+                std::fprintf(stderr, "%2d|%s|\n", row, line.c_str());
+            }
+            for (const OverlayItem& item : items)
+                std::fprintf(stderr, "item %d,%d-%d,%d %s\n", item.column0, item.row0,
+                             item.column1, item.row1, item.text.c_str());
+        }
+    }
+
+    const float cellWidth = size.x / HgrTextScreen::Columns;
+    const float cellHeight = size.y / HgrTextScreen::Rows;
+    const ImU32 white = IM_COL32(255, 255, 255, 255);
+    const ImU32 black = IM_COL32(0, 0, 0, 255);
+
+    // The boot menu's three choices are drawn as large bitmap lettering, not
+    // with the font. Recognise the screen by its copyright line instead.
+    static const bool dumpText = std::getenv("DLRL_DUMP_TEXT") != nullptr;
+    if (dumpText && screen.Signature() != 0)
+    {
+        static std::uint64_t lastMenuHash = 0;
+        const std::uint64_t hash = screen.RegionHash(7, 16);
+        if (hash != lastMenuHash)
+            std::fprintf(stderr, "menu hash %016llx\n", static_cast<unsigned long long>(hash));
+        lastMenuHash = hash;
+    }
+    for (int pass = 0; pass < 1; ++pass)
+    {
+        const std::uint64_t menuHash = screen.RegionHash(7, 16);
+        if (menuHash != kBootMenuHashes[0] && menuHash != kBootMenuHashes[1]) continue;
+        const float lineTop = topLeft.y + size.y * (142.5f / 192.0f);
+        const float lineBottom = topLeft.y + size.y * (174.5f / 192.0f);
+        draw->AddRectFilled(ImVec2(topLeft.x + cellWidth, lineTop),
+                            ImVec2(topLeft.x + size.x - cellWidth, lineBottom), black);
+        static const char* const choices[] = {
+            "U  ユーティリティ", "C  キャラクター設定", "P  ゲームを始める"};
+        const float fontSize = SnapSize((lineBottom - lineTop) / 3.0f);
+        const ImU32 violet = IM_COL32(220, 120, 255, 255);
+        for (int index = 0; index < 3; ++index)
+        {
+            const std::string choice = choices[index];
+            const float y = lineTop + (lineBottom - lineTop) * index / 3.0f
+                          + ((lineBottom - lineTop) / 3.0f - fontSize) * 0.5f;
+            DrawJapanese(draw, ImVec2(topLeft.x + (size.x - TextWidth(choice, fontSize)) * 0.5f, y),
+                         fontSize, violet, choice);
+        }
+        break;
+    }
+
+    // Cover every source first and draw the translations afterwards, so a
+    // neighbour's background never clips glyphs that reach into its row.
+    struct TextDraw
+    {
+        ImVec2 position;
+        float size;
+        ImU32 color;
+        std::string text;
+    };
+    std::vector<TextDraw> texts;
+    std::vector<std::pair<ImVec2, ImVec2>> inverseBars;
+    for (const OverlayItem& item : items)
+    {
+        // Grow single-line labels over neighbouring blank cells when the
+        // translation is wider than the English it replaces.
+        int column0 = item.column0;
+        int column1 = item.column1;
+        const int rows = item.row1 - item.row0 + 1;
+        float fontSize = SnapSize(cellHeight);
+        auto blankColumn = [&](int column)
+        {
+            if (column < 0 || column >= HgrTextScreen::Columns) return false;
+            for (int row = item.row0; row <= item.row1; ++row)
+            {
+                const HgrTextCell& cell = screen.Cell(column, row);
+                if (!cell.known || cell.ch != ' ' || cell.inverse != item.inverse) return false;
+            }
+            return true;
+        };
+        std::vector<std::string> lines;
+        for (int attempt = 0; attempt < 24; ++attempt)
+        {
+            const float width = (column1 - column0 + 1) * cellWidth;
+            lines = Wrap(item.text, fontSize, width);
+            const float height = lines.size() * fontSize;
+            if (height <= rows * cellHeight + 0.5f) break;
+            bool grew = false;
+            if (blankColumn(column1 + 1)) { ++column1; grew = true; }
+            if (blankColumn(column0 - 1)) { --column0; grew = true; }
+            if (!grew)
+            {
+                if (fontSize <= 8.0f || fontSize <= cellHeight * 0.5f) break;
+                fontSize -= 8.0f;
+            }
+        }
+        const ImVec2 min(topLeft.x + column0 * cellWidth, topLeft.y + item.row0 * cellHeight);
+        const ImVec2 max(topLeft.x + (column1 + 1) * cellWidth,
+                         topLeft.y + (item.row1 + 1) * cellHeight);
+        // Cover the original glyphs of the source cells too.
+        const ImVec2 sourceMin(topLeft.x + item.column0 * cellWidth, min.y);
+        const ImVec2 sourceMax(topLeft.x + (item.column1 + 1) * cellWidth, max.y);
+        // NTSC colour bleed and the half-pixel palette shift smear glyph
+        // edges past their cell; pad into neighbouring blank cells, and a
+        // little upward into the (always empty) bottom line of the row above.
+        auto emptyColumn = [&](int column)
+        {
+            if (column < 0 || column >= HgrTextScreen::Columns) return false;
+            for (int row = item.row0; row <= item.row1; ++row)
+            {
+                const HgrTextCell& cell = screen.Cell(column, row);
+                if (!cell.known || cell.ch != ' ' || cell.inverse) return false;
+            }
+            return true;
+        };
+        const float left = std::min(min.x, sourceMin.x);
+        const float right = std::max(max.x, sourceMax.x);
+        const float padLeft = emptyColumn(std::min(column0, item.column0) - 1) ? cellWidth * 0.5f : 0.0f;
+        const float padRight = emptyColumn(std::max(column1, item.column1) + 1) ? cellWidth * 0.5f : 0.0f;
+        const float padTop = cellHeight * 0.12f;
+        draw->AddRectFilled(ImVec2(left - padLeft, min.y - padTop),
+                            ImVec2(right + padRight, max.y), black);
+        if (item.inverse) inverseBars.push_back({ImVec2(left, min.y), ImVec2(right, max.y)});
+        const float lineHeight = fontSize;
+        const float textHeight = lines.size() * lineHeight;
+        float y = min.y + std::max(0.0f, (max.y - min.y - textHeight) * 0.5f);
+        for (const std::string& line : lines)
+        {
+            float x = min.x;
+            if (item.centered)
+                x = min.x + std::max(0.0f, ((max.x - min.x) - TextWidth(line, fontSize)) * 0.5f);
+            texts.push_back({ImVec2(x, y), fontSize, item.inverse ? black : white, line});
+            if (dumpText && item.inverse)
+                std::fprintf(stderr, "inv rect y %.1f-%.1f text y %.1f size %.0f cell %.1f\n",
+                             min.y, max.y, y, fontSize, cellHeight);
+            y += lineHeight;
+        }
+    }
+    for (const auto& bar : inverseBars) draw->AddRectFilled(bar.first, bar.second, white);
+    for (const TextDraw& text : texts)
+        DrawJapanese(draw, text.position, text.size, text.color, text.text);
+}
+
+} // namespace loc
