+#pragma once
+
+// Japanese localization layer.
+//
+// * UI chrome (menus, dialogs, panels) goes through T().
+// * Game text is never patched inside the 6502 program. Instead the host
+//   recognises the English text Deathlord printed (from the message hooks or
+//   by reading the hi-res screen) and draws the translation over it.
+
+#include <filesystem>
+#include <string>
+#include <vector>
+
+struct ImDrawList;
+struct ImFont;
+struct ImVec2;
+
+namespace loc
+{
+
+bool Load(const std::filesystem::path& directory);
+bool Loaded();
+bool Enabled();
+void SetEnabled(bool enabled);
+
+// UI strings. "Label##id" translates "Label" and keeps "##id".
+const char* T(const char* english);
+std::string T(const std::string& english);
+
+// Game text, matched ignoring whitespace and case. nullptr when unknown.
+const std::string* LookupGame(const std::string& text);
+// Translated text when enabled and known; otherwise the input.
+std::string Display(const std::string& text);
+
+struct SpanMatch
+{
+    int first = 0;
+    int count = 0;
+    std::string text;
+};
+// Greedily covers consecutive lines (oldest first) with the longest spans
+// that form a known message. Empty strings are blank lines.
+std::vector<SpanMatch> MatchLines(const std::vector<std::string>& lines,
+                                  int maxSpan = 12);
+
+bool HasNonAscii(const std::string& text);
+// Debug aid: with DLRL_DUMP_UNMATCHED set, prints each distinct untranslated line once.
+void NoteUnmatched(const std::string& text);
+
+void SetFont(ImFont* font);
+ImFont* Font();
+float SnapSize(float size);
+float TextWidth(const std::string& text, float size);
+std::vector<std::string> Wrap(const std::string& text, float size, float width);
+void DrawJapanese(ImDrawList* draw, const ImVec2& position, float size,
+              unsigned int color, const std::string& text);
+
+// Draws Japanese replacements over an Apple //e image whose active 560x384
+// area occupies [topLeft, topLeft + size].
+void DrawAppleOverlay(ImDrawList* draw, const ImVec2& topLeft, const ImVec2& size);
+
+} // namespace loc
