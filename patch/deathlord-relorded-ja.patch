@@ -0,0 +1,855 @@
+#include "Localization.h"
+
+#include "HgrText.h"
+
+#include <imgui.h>
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cfloat>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <optional>
+#include <regex>
+#include <unordered_map>
+
+namespace loc
+{
+namespace
+{
+
+struct Pattern
+{
+    std::regex expression;
+    std::string replacement;
+};
+
+struct State
+{
+    bool loaded = false;
+    bool enabled = true;
+    ImFont* font = nullptr;
+    std::unordered_map<std::string, std::string> ui;
+    std::unordered_map<std::string, std::string> uiResolved;
+    std::unordered_map<std::uint64_t, std::string> game; // hash of normalized key -> ja
+    std::vector<Pattern> patterns;
+    std::unordered_map<std::string, std::optional<std::string>> cache;
+};
+
+State& S()
+{
+    static State state;
+    return state;
+}
+
+// game.json identifies each English original only by this hash (FNV-1a,
+// 64-bit, over the normalized key) so it never has to ship the game's text.
+std::uint64_t KeyHash(const std::string& key)
+{
+    std::uint64_t hash = 14695981039346656037ULL;
+    for (const unsigned char c : key) hash = (hash ^ c) * 1099511628211ULL;
+    return hash;
+}
+
+// Whitespace never matters: Deathlord pre-wraps text at 18 columns, pads
+// signs with spaces and hard-wraps mid-word, so keys drop it entirely.
+std::string NormalizeKey(const std::string& text)
+{
+    std::string key;
+    key.reserve(text.size());
+    for (const unsigned char c : text)
+    {
+        if (c <= ' ') continue;
+        key.push_back(static_cast<char>(std::toupper(c)));
+    }
+    return key;
+}
+
+std::string Collapse(const std::string& text)
+{
+    std::string out;
+    bool space = false;
+    for (const unsigned char c : text)
+    {
+        if (c <= ' ')
+        {
+            space = !out.empty();
+            continue;
+        }
+        if (space) out.push_back(' ');
+        space = false;
+        out.push_back(static_cast<char>(std::toupper(c)));
+    }
+    return out;
+}
+
+std::optional<std::string> ApplyPatterns(const std::string& spaced)
+{
+    State& s = S();
+    for (const Pattern& pattern : s.patterns)
+    {
+        std::smatch match;
+        if (!std::regex_match(spaced, match, pattern.expression)) continue;
+        std::string out;
+        const std::string& r = pattern.replacement;
+        for (std::size_t i = 0; i < r.size(); ++i)
+        {
+            if (r[i] == '{' && i + 2 < r.size() && std::isdigit(static_cast<unsigned char>(r[i + 1])))
+            {
+                std::size_t end = r.find('}', i);
+                if (end != std::string::npos)
+                {
+                    const std::string spec = r.substr(i + 1, end - i - 1);
+                    const bool raw = !spec.empty() && spec.back() == 'r';
+                    const int group = std::atoi(spec.c_str());
+                    std::string capture = group < static_cast<int>(match.size())
+                        ? match[group].str() : std::string();
+                    while (!capture.empty() && capture.back() == ' ') capture.pop_back();
+                    while (!capture.empty() && capture.front() == ' ') capture.erase(capture.begin());
+                    if (!raw)
+                    {
+                        const auto found = s.game.find(KeyHash(NormalizeKey(capture)));
+                        if (found != s.game.end()) capture = found->second;
+                    }
+                    out += capture;
+                    i = end;
+                    continue;
+                }
+            }
+            out.push_back(r[i]);
+        }
+        // A pattern whose captures stayed English adds nothing; keep looking.
+        if (HasNonAscii(out)) return out;
+    }
+    return std::nullopt;
+}
+
+const std::string* Exact(const std::string& text)
+{
+    State& s = S();
+    const std::string key = NormalizeKey(text);
+    if (key.empty()) return nullptr;
+    const auto found = s.game.find(KeyHash(key));
+    return found == s.game.end() ? nullptr : &found->second;
+}
+
+// "Attack-East", "Yell-TROLL", "ALIGNMENT: GOOD": a known prompt followed by
+// the player's input or a value. The tail is translated when it is known and
+// otherwise kept verbatim, but only when it is a single word.
+std::optional<std::string> SplitPrompt(const std::string& spaced)
+{
+    for (std::size_t p = spaced.size(); p-- > 1;)
+    {
+        const char c = spaced[p];
+        if (c != '-' && c != ':' && c != '?' && c != '#') continue;
+        const std::string* prompt = Exact(spaced.substr(0, p + 1));
+        if (!prompt) continue;
+        std::string rest = spaced.substr(p + 1);
+        while (!rest.empty() && rest.front() == ' ') rest.erase(rest.begin());
+        if (rest.empty()) return *prompt;
+        if (const std::string* known = Exact(rest)) return *prompt + *known;
+        if (rest.find(' ') != std::string::npos) return std::nullopt;
+        return *prompt + rest;
+    }
+    return std::nullopt;
+}
+
+// Exact matches may span lines; patterns and prompt splitting are limited to
+// single lines so they never swallow a neighbouring message.
+const std::string* Find(const std::string& joined, bool fuzzy = true)
+{
+    State& s = S();
+    const std::string key = NormalizeKey(joined);
+    if (key.empty()) return nullptr;
+    const auto exact = s.game.find(KeyHash(key));
+    if (exact != s.game.end()) return &exact->second;
+    if (!fuzzy) return nullptr;
+    auto cached = s.cache.find(key);
+    if (cached == s.cache.end())
+    {
+        const std::string spaced = Collapse(joined);
+        std::optional<std::string> value = ApplyPatterns(spaced);
+        if (!value) value = SplitPrompt(spaced);
+        if (s.cache.size() > 20000) s.cache.clear();
+        cached = s.cache.emplace(key, std::move(value)).first;
+    }
+    return cached->second ? &*cached->second : nullptr;
+}
+
+} // namespace
+
+bool Load(const std::filesystem::path& directory)
+{
+    State& s = S();
+    s.ui.clear();
+    s.uiResolved.clear();
+    s.game.clear();
+    s.patterns.clear();
+    s.cache.clear();
+    bool any = false;
+    try
+    {
+        std::ifstream uiFile(directory / "ui.json");
+        if (uiFile)
+        {
+            const nlohmann::json json = nlohmann::json::parse(uiFile);
+            for (const auto& [english, japanese] : json.at("strings").items())
+                if (japanese.is_string() && !japanese.get<std::string>().empty())
+                    s.ui[english] = japanese.get<std::string>();
+            any = true;
+        }
+    }
+    catch (const std::exception&) {}
+    try
+    {
+        std::ifstream gameFile(directory / "game.json");
+        if (gameFile)
+        {
+            const nlohmann::json json = nlohmann::json::parse(gameFile);
+            for (const auto& entry : json.at("entries"))
+            {
+                if (!entry.contains("ja") || !entry["ja"].is_string()) continue;
+                const std::string japanese = entry["ja"].get<std::string>();
+                if (japanese.empty()) continue;
+                if (entry.contains("key"))
+                    s.game.emplace(std::stoull(entry["key"].get<std::string>(), nullptr, 16),
+                                   japanese);
+                else if (const std::string key = NormalizeKey(entry.at("src").get<std::string>());
+                         !key.empty())
+                    s.game.emplace(KeyHash(key), japanese);
+            }
+            if (json.contains("patterns"))
+            {
+                for (const auto& entry : json["patterns"])
+                {
+                    try
+                    {
+                        s.patterns.push_back({std::regex(entry.at("re").get<std::string>(),
+                                                         std::regex::ECMAScript | std::regex::icase
+                                                             | std::regex::optimize),
+                                              entry.at("ja").get<std::string>()});
+                    }
+                    catch (const std::exception&) {}
+                }
+            }
+            any = true;
+        }
+    }
+    catch (const std::exception&) {}
+    s.loaded = any;
+    return any;
+}
+
+bool Loaded() { return S().loaded; }
+bool Enabled() { return S().enabled && S().loaded; }
+void SetEnabled(bool enabled) { S().enabled = enabled; }
+
+const char* T(const char* english)
+{
+    if (!english || !Enabled()) return english;
+    State& s = S();
+    auto resolved = s.uiResolved.find(english);
+    if (resolved != s.uiResolved.end()) return resolved->second.c_str();
+
+    std::string visible = english;
+    std::string suffix;
+    const std::size_t hashes = visible.find("##");
+    if (hashes != std::string::npos)
+    {
+        suffix = visible.substr(hashes);
+        visible.resize(hashes);
+    }
+    std::string result = english;
+    const auto found = s.ui.find(visible);
+    if (found != s.ui.end())
+        result = found->second + suffix;
+    else if (const std::string* game = LookupGame(visible); game && !visible.empty())
+        result = *game + suffix;
+    return s.uiResolved.emplace(english, std::move(result)).first->second.c_str();
+}
+
+std::string T(const std::string& english) { return T(english.c_str()); }
+
+const std::string* LookupGame(const std::string& text)
+{
+    if (!Enabled()) return nullptr;
+    return Find(text);
+}
+
+std::string Display(const std::string& text)
+{
+    if (!Enabled() || text.empty() || HasNonAscii(text)) return text;
+    const auto ui = S().ui.find(text);
+    if (ui != S().ui.end()) return ui->second;
+    if (const std::string* game = Find(text)) return *game;
+    return text;
+}
+
+std::vector<SpanMatch> MatchLines(const std::vector<std::string>& lines, int maxSpan)
+{
+    std::vector<SpanMatch> matches;
+    if (!Enabled()) return matches;
+    auto blank = [](const std::string& line)
+    {
+        return std::all_of(line.begin(), line.end(),
+                           [](unsigned char c) { return c <= ' '; });
+    };
+    const int count = static_cast<int>(lines.size());
+    for (int first = 0; first < count;)
+    {
+        if (blank(lines[first]))
+        {
+            ++first;
+            continue;
+        }
+        int matched = 0;
+        const std::string* text = nullptr;
+        for (int span = std::min(maxSpan, count - first); span >= 1; --span)
+        {
+            if (blank(lines[first + span - 1])) continue;
+            std::string joined;
+            for (int i = 0; i < span; ++i)
+            {
+                if (i) joined.push_back(' ');
+                joined += lines[first + i];
+            }
+            text = Find(joined, span == 1);
+            if (text)
+            {
+                matched = span;
+                break;
+            }
+        }
+        if (matched)
+        {
+            matches.push_back({first, matched, *text});
+            first += matched;
+        }
+        else ++first;
+    }
+    return matches;
+}
+
+void NoteUnmatched(const std::string& text)
+{
+    static const bool enabled = std::getenv("DLRL_DUMP_UNMATCHED") != nullptr;
+    if (!enabled || !Enabled()) return;
+    const std::string key = NormalizeKey(text);
+    if (key.empty() || HasNonAscii(text)) return;
+    static std::unordered_map<std::string, bool> seen;
+    if (seen.emplace(key, true).second) std::fprintf(stderr, "UNMATCHED|%s|\n", text.c_str());
+}
+
+bool HasNonAscii(const std::string& text)
+{
+    return std::any_of(text.begin(), text.end(),
+                       [](char c) { return static_cast<unsigned char>(c) >= 0x80; });
+}
+
+void SetFont(ImFont* font) { S().font = font; }
+ImFont* Font() { return S().font ? S().font : ImGui::GetFont(); }
+
+float SnapSize(float size)
+{
+    // Misaki is drawn on its native 8-dot grid: whole multiples of 8px.
+    return std::max(8.0f, std::round(size / 8.0f) * 8.0f);
+}
+
+float TextWidth(const std::string& text, float size)
+{
+    size = SnapSize(size);
+    return Font()->CalcTextSizeA(size, FLT_MAX, 0.0f, text.c_str(),
+                                 text.c_str() + text.size()).x;
+}
+
+std::vector<std::string> Wrap(const std::string& text, float size, float width)
+{
+    // Japanese breaks between any two characters; keep ASCII words whole and
+    // apply basic kinsoku so punctuation never starts a line.
+    static const std::string noLineStart =
+        "、。，．・ー」』）)]！？!?…ぁぃぅぇぉっゃゅょァィゥェォッャュョ:：";
+    std::vector<std::string> tokens;
+    for (std::size_t i = 0; i < text.size();)
+    {
+        const unsigned char c = static_cast<unsigned char>(text[i]);
+        if (c == '\n')
+        {
+            tokens.emplace_back("\n");
+            ++i;
+        }
+        else if (c < 0x80)
+        {
+            if (c == ' ')
+            {
+                tokens.emplace_back(" ");
+                ++i;
+                continue;
+            }
+            std::size_t j = i;
+            while (j < text.size() && static_cast<unsigned char>(text[j]) < 0x80
+                   && text[j] != ' ' && text[j] != '\n')
+                ++j;
+            tokens.push_back(text.substr(i, j - i));
+            i = j;
+        }
+        else
+        {
+            const std::size_t length = c >= 0xF0 ? 4 : c >= 0xE0 ? 3 : 2;
+            tokens.push_back(text.substr(i, length));
+            i += length;
+        }
+    }
+
+    std::vector<std::string> lines(1);
+    float lineWidth = 0;
+    for (std::size_t index = 0; index < tokens.size(); ++index)
+    {
+        const std::string& token = tokens[index];
+        if (token == "\n")
+        {
+            lines.emplace_back();
+            lineWidth = 0;
+            continue;
+        }
+        if (token == " " && lines.back().empty()) continue;
+        const float tokenWidth = TextWidth(token, size);
+        const bool forbidden = noLineStart.find(token) != std::string::npos
+                               && static_cast<unsigned char>(token[0]) >= 0x80;
+        const bool forbiddenAscii = token.size() == 1 && std::string(")]!?.,:").find(token) != std::string::npos;
+        if (lineWidth + tokenWidth > width + 0.5f && !lines.back().empty()
+            && !forbidden && !forbiddenAscii)
+        {
+            while (!lines.back().empty() && lines.back().back() == ' ') lines.back().pop_back();
+            lines.emplace_back();
+            lineWidth = 0;
+            if (token == " ") continue;
+        }
+        lines.back() += token;
+        lineWidth += tokenWidth;
+    }
+    while (!lines.empty() && lines.back().empty()) lines.pop_back();
+    return lines;
+}
+
+void DrawJapanese(ImDrawList* draw, const ImVec2& position, float size,
+              unsigned int color, const std::string& text)
+{
+    size = SnapSize(size);
+    draw->AddText(Font(), size, ImVec2(std::floor(position.x), std::floor(position.y)),
+                  color, text.c_str(), text.c_str() + text.size());
+}
