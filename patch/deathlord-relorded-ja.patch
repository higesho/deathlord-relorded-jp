+namespace
+{
+
+struct OverlayItem
+{
+    int column0 = 0, row0 = 0, column1 = 0, row1 = 0; // inclusive cells
+    std::string text;
+    bool inverse = false;
+    bool centered = false;
+};
+
+struct Segment
+{
+    int row = 0, column0 = 0, column1 = 0;
+    std::string text;
+    bool inverse = false;
+    int chain = -1;
+};
+
+std::vector<OverlayItem> BuildOverlay(const HgrTextScreen& screen)
+{
+    std::vector<Segment> segments;
+    std::array<std::vector<int>, HgrTextScreen::Rows> byRow;
+    for (int row = 0; row < HgrTextScreen::Rows; ++row)
+    {
+        int column = 0;
+        while (column < HgrTextScreen::Columns)
+        {
+            auto content = [&](int c)
+            {
+                const HgrTextCell& cell = screen.Cell(c, row);
+                return cell.known && (cell.ch != ' ' || cell.inverse);
+            };
+            if (!content(column))
+            {
+                ++column;
+                continue;
+            }
+            Segment segment;
+            segment.row = row;
+            segment.column0 = column;
+            int last = column;
+            int inverseCount = 0, total = 0;
+            while (column < HgrTextScreen::Columns)
+            {
+                if (content(column))
+                {
+                    last = column;
+                    ++total;
+                    if (screen.Cell(column, row).inverse) ++inverseCount;
+                    ++column;
+                    continue;
+                }
+                // A single blank cell is a word space; two end the segment.
+                if (column + 1 < HgrTextScreen::Columns && screen.Cell(column, row).known
+                    && content(column + 1))
+                {
+                    ++column;
+                    continue;
+                }
+                break;
+            }
+            segment.column1 = last;
+            for (int c = segment.column0; c <= last; ++c)
+            {
+                const HgrTextCell& cell = screen.Cell(c, row);
+                segment.text.push_back(cell.known ? cell.ch : ' ');
+            }
+            segment.inverse = inverseCount * 2 > total;
+            byRow[row].push_back(static_cast<int>(segments.size()));
+            segments.push_back(std::move(segment));
+        }
+    }
+
+    auto overlap = [](const Segment& a, const Segment& b)
+    {
+        return std::min(a.column1, b.column1) - std::max(a.column0, b.column0) + 1;
+    };
+
+    std::vector<OverlayItem> items;
+    for (std::size_t start = 0; start < segments.size(); ++start)
+    {
+        if (segments[start].chain >= 0) continue;
+        // Follow vertically overlapping segments (allowing one blank row) to
+        // rebuild multi-line messages printed into a window.
+        std::vector<int> chain{static_cast<int>(start)};
+        std::vector<std::string> lines{segments[start].text};
+        std::vector<int> lineSegment{static_cast<int>(start)};
+        segments[start].chain = static_cast<int>(start);
+        int current = static_cast<int>(start);
+        while (true)
+        {
+            int next = -1;
+            int skipped = 0;
+            for (int gap = 1; gap <= 2 && next < 0; ++gap)
+            {
+                const int row = segments[current].row + gap;
+                if (row >= HgrTextScreen::Rows) break;
+                int best = 0;
+                for (const int candidate : byRow[row])
+                {
+                    if (segments[candidate].chain >= 0) continue;
+                    if (segments[candidate].inverse != segments[current].inverse) continue;
+                    const int amount = overlap(segments[current], segments[candidate]);
+                    if (amount > best)
+                    {
+                        best = amount;
+                        next = candidate;
+                    }
+                }
+                if (next < 0)
+                {
+                    // Only skip a row that has nothing at all under us.
+                    bool occupied = false;
+                    for (const int candidate : byRow[row])
+                        if (overlap(segments[current], segments[candidate]) > 0) occupied = true;
+                    if (occupied) break;
+                    skipped = gap;
+                }
+            }
+            if (next < 0) break;
+            for (int i = 0; i < skipped; ++i)
+            {
+                lines.emplace_back();
+                lineSegment.push_back(-1);
+            }
+            segments[next].chain = static_cast<int>(start);
+            lines.push_back(segments[next].text);
+            lineSegment.push_back(next);
+            current = next;
+        }
+
+        const std::vector<SpanMatch> matches = MatchLines(lines);
+        std::vector<bool> covered(lines.size(), false);
+        for (const SpanMatch& match : matches)
+            for (int i = match.first; i < match.first + match.count; ++i) covered[i] = true;
+        // A line left unmatched may be two columns separated by one space
+        // ("Nintoshi Troll"). Split it into words only when known phrases
+        // cover every word, so sentences never come out half translated.
+        for (std::size_t i = 0; i < lines.size(); ++i)
+        {
+            if (covered[i] || lineSegment[i] < 0) continue;
+            const Segment& segment = segments[lineSegment[i]];
+            struct Word { int column0, column1; std::string text; };
+            std::vector<Word> words;
+            for (int c = 0; c < static_cast<int>(segment.text.size());)
+            {
+                if (segment.text[c] == ' ') { ++c; continue; }
+                int end = c;
+                while (end < static_cast<int>(segment.text.size()) && segment.text[end] != ' ') ++end;
+                words.push_back({segment.column0 + c, segment.column0 + end - 1,
+                                 segment.text.substr(c, end - c)});
+                c = end;
+            }
+            if (words.size() < 2) continue;
+            std::vector<OverlayItem> parts;
+            bool complete = true;
+            for (std::size_t w = 0; w < words.size() && complete;)
+            {
+                std::size_t taken = 0;
+                for (std::size_t length = words.size() - w; length >= 1 && !taken; --length)
+                {
+                    if (length == words.size()) continue; // the whole line already failed
+                    std::string phrase;
+                    for (std::size_t k = 0; k < length; ++k)
+                        phrase += (k ? " " : "") + words[w + k].text;
+                    if (const std::string* text = Find(phrase, false))
+                    {
+                        OverlayItem part;
+                        part.column0 = words[w].column0;
+                        part.column1 = words[w + length - 1].column1;
+                        part.row0 = part.row1 = segment.row;
+                        part.text = *text;
+                        part.inverse = segment.inverse;
+                        parts.push_back(std::move(part));
+                        taken = length;
+                    }
+                }
+                if (!taken) complete = false;
+                w += taken;
+            }
+            if (complete)
+                for (OverlayItem& part : parts) items.push_back(std::move(part));
+            else
+                NoteUnmatched(segment.text);
+        }
+
+        for (const SpanMatch& match : matches)
+        {
+            OverlayItem item;
+            item.column0 = HgrTextScreen::Columns;
+            item.row0 = HgrTextScreen::Rows;
+            item.column1 = -1;
+            item.row1 = -1;
+            item.text = match.text;
+            int segmentsInSpan = 0;
+            for (int i = match.first; i < match.first + match.count; ++i)
+            {
+                const int index = lineSegment[i];
+                if (index < 0) continue;
+                const Segment& segment = segments[index];
+                item.column0 = std::min(item.column0, segment.column0);
+                item.column1 = std::max(item.column1, segment.column1);
+                item.row0 = std::min(item.row0, segment.row);
+                item.row1 = std::max(item.row1, segment.row);
+                item.inverse = segment.inverse;
+                ++segmentsInSpan;
+            }
+            // Centre a single line only when the English was centred in its
+            // blank surroundings (menus); window text stays left-aligned.
+            if (segmentsInSpan == 1)
+            {
+                auto blankRun = [&](int column, int step)
+                {
+                    int count = 0;
+                    for (int c = column; c >= 0 && c < HgrTextScreen::Columns; c += step)
+                    {
+                        const HgrTextCell& cell = screen.Cell(c, item.row0);
+                        if (!cell.known || cell.ch != ' ' || cell.inverse) break;
+                        ++count;
+                    }
+                    return count;
+                };
+                const int left = blankRun(item.column0 - 1, -1);
+                const int right = blankRun(item.column1 + 1, 1);
+                item.centered = left > 0 && std::abs(left - right) <= 1;
+            }
+            if (item.column1 >= 0) items.push_back(std::move(item));
+        }
+    }
+    return items;
+}
+
