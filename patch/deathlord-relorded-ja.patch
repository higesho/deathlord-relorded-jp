diff --git a/src/AppleStyle.cpp b/src/AppleStyle.cpp
index d2829e2..2ac306f 100644
--- a/src/AppleStyle.cpp
+++ b/src/AppleStyle.cpp
@@ -1,4 +1,5 @@
 #include "AppleStyle.h"
+#include "Localization.h"
 
 #include <SDL3/SDL_filesystem.h>
 #include <imgui.h>
@@ -88,6 +89,26 @@ void ApplyAppleStyle(InterfaceColor color)
             io.Fonts->Clear();
             io.Fonts->AddFontFromFileTTF(berkelium.string().c_str(), 16.0f);
         }
+        const auto japanese = FindAssetPath("misaki_gothic_2nd.ttf");
+        if (!japanese.empty())
+        {
+            // Misaki Gothic is an 8x8 dot font (em = 8 dots), the same grid
+            // as Deathlord's own 7x8 glyphs. Rasterise it without
+            // oversampling so multiples of 8px stay pixel-sharp. Its glyphs
+            // merge into the default UI font and a standalone instance draws
+            // translated game text on the canvas and the Apple screen.
+            ImFontConfig config;
+            config.OversampleH = 1;
+            config.OversampleV = 1;
+            config.PixelSnapH = true;
+            if (!berkelium.empty())
+            {
+                ImFontConfig merge = config;
+                merge.MergeMode = true;
+                io.Fonts->AddFontFromFileTTF(japanese.string().c_str(), 16.0f, &merge);
+            }
+            loc::SetFont(io.Fonts->AddFontFromFileTTF(japanese.string().c_str(), 16.0f, &config));
+        }
         if (!proggyTiny.empty())
