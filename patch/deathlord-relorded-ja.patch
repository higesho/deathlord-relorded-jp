+#pragma once
+
+// Recovers the text Deathlord has drawn on the Apple //e hi-res screen.
+// Every Deathlord module prints with the same 7x8 bitmap font on byte-aligned
+// 40x24 cells, so matching each cell's eight HGR bytes against that font
+// yields the visible text regardless of which program module drew it.
+
+#include <array>
+#include <cstdint>
+#include <string>
+
+struct HgrTextCell
+{
+    char ch = ' ';
+    bool inverse = false;
+    bool known = false; // false: the cell holds graphics, not a font glyph
+};
+
+class HgrTextScreen
+{
+public:
+    static constexpr int Columns = 40;
+    static constexpr int Rows = 24;
+
+    // Reads the currently displayed hi-res page. Returns false when the
+    // machine is not showing a hi-res page (nothing to recognise).
+    bool Scan();
+
+    const HgrTextCell& Cell(int column, int row) const { return cells_[row][column]; }
+    std::string RowText(int row) const;
+    std::uint64_t Signature() const { return signature_; }
+    // Hash of the raw hi-res bytes of whole character rows [row0, row1],
+    // used to recognise screens drawn as bitmaps rather than text.
+    std::uint64_t RegionHash(int row0, int row1) const;
+
+private:
+    std::array<std::array<HgrTextCell, Columns>, Rows> cells_{};
+    std::uint64_t signature_ = 0;
+    std::uint16_t base_ = 0x2000;
+};
