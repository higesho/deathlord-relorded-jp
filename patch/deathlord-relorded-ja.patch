+struct DisplayRow
+{
+    std::string text;
+    bool inverse = false;
+};
+
+// Rebuilds Deathlord's 18-column message lines (oldest first) into display
+// rows, replacing every recognised message with its wrapped translation.
+std::vector<DisplayRow> TranslateRows(const std::vector<DisplayRow>& lines,
+                                      float width, float logicalSize)
+{
+    std::vector<std::string> texts;
+    texts.reserve(lines.size());
+    for (const DisplayRow& line : lines) texts.push_back(line.text);
+    const std::vector<loc::SpanMatch> matches = loc::MatchLines(texts);
+    std::vector<DisplayRow> rows;
+    std::size_t next = 0;
+    for (int index = 0; index < static_cast<int>(lines.size());)
+    {
+        if (next < matches.size() && matches[next].first == index)
+        {
+            bool inverse = false;
+            for (int k = 0; k < matches[next].count; ++k) inverse |= lines[index + k].inverse;
+            for (std::string& wrapped : loc::Wrap(matches[next].text, logicalSize, width))
+                rows.push_back({std::move(wrapped), inverse});
+            index += matches[next].count;
+            ++next;
+        }
+        else
+        {
+            loc::NoteUnmatched(lines[index].text);
+            rows.push_back(lines[index]);
+            ++index;
+        }
+    }
+    return rows;
+}
