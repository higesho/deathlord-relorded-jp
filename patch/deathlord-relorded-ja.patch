+std::uint64_t Pack(const std::uint8_t* bytes)
+{
+    std::uint64_t key = 0;
+    for (int i = 0; i < 8; ++i) key |= static_cast<std::uint64_t>(bytes[i] & 0x7F) << (i * 8);
+    return key;
+}
+
+struct GlyphTable
+{
+    std::unordered_map<std::uint64_t, std::pair<char, bool>> map;
+    GlyphTable()
+    {
+        for (int c = 95; c >= 0; --c)
+        {
+            std::uint8_t inverse[8];
+            for (int i = 0; i < 8; ++i) inverse[i] = static_cast<std::uint8_t>(kFont[c][i] ^ 0x7F);
+            // Iterate downward so the lowest code wins for duplicate blanks.
+            map[Pack(kFont[c])] = {static_cast<char>(0x20 + c), false};
+            map[Pack(inverse)] = {static_cast<char>(0x20 + c), true};
+        }
+        map[0] = {' ', false};
+        map[0x7F7F7F7F7F7F7F7FULL] = {' ', true};
+    }
+};
+
+const GlyphTable& Glyphs()
+{
+    static const GlyphTable table;
+    return table;
+}
+
+} // namespace
+
+bool HgrTextScreen::Scan()
+{
+    Video& video = GetVideo();
+    const bool hires = video.VideoGetSWHIRES() && !video.VideoGetSWTEXT();
+    if (!hires)
+    {
+        for (auto& row : cells_) row.fill(HgrTextCell{});
+        signature_ = 0;
+        return false;
+    }
+    const std::uint16_t base = video.VideoGetSWPAGE2() && !video.VideoGetSW80STORE() ? 0x4000 : 0x2000;
+    base_ = base;
+    const std::uint8_t* memory = MemGetMainPtr(0);
+    const GlyphTable& glyphs = Glyphs();
+    std::uint64_t hash = 1469598103934665603ULL;
+    for (int row = 0; row < Rows; ++row)
+    {
+        const std::uint16_t rowBase = static_cast<std::uint16_t>(
+            base + (row & 7) * 0x80 + (row >> 3) * 0x28);
+        for (int column = 0; column < Columns; ++column)
+        {
+            std::uint8_t bytes[8];
+            for (int line = 0; line < 8; ++line)
+                bytes[line] = memory[rowBase + line * 0x400 + column];
+            HgrTextCell cell;
+            const auto found = glyphs.map.find(Pack(bytes));
+            if (found != glyphs.map.end())
+            {
+                cell.ch = found->second.first;
+                cell.inverse = found->second.second;
+                cell.known = true;
+            }
+            cells_[row][column] = cell;
+            hash = (hash ^ static_cast<std::uint8_t>(cell.ch)) * 1099511628211ULL;
+            hash = (hash ^ (cell.inverse ? 1u : 0u) ^ (cell.known ? 2u : 0u)) * 1099511628211ULL;
+        }
+    }
+    signature_ = hash;
+    return true;
+}
+
+std::string HgrTextScreen::RowText(int row) const
+{
+    std::string text;
+    for (int column = 0; column < Columns; ++column)
+    {
+        const HgrTextCell& cell = cells_[row][column];
+        text.push_back(cell.known ? cell.ch : ' ');
+    }
+    return text;
+}
+
+std::uint64_t HgrTextScreen::RegionHash(int row0, int row1) const
+{
+    const std::uint8_t* memory = MemGetMainPtr(0);
+    std::uint64_t hash = 1469598103934665603ULL;
+    for (int row = row0; row <= row1; ++row)
+    {
+        const std::uint16_t rowBase = static_cast<std::uint16_t>(
+            base_ + (row & 7) * 0x80 + (row >> 3) * 0x28);
+        for (int line = 0; line < 8; ++line)
+            for (int column = 0; column < Columns; ++column)
+                hash = (hash ^ memory[rowBase + line * 0x400 + column]) * 1099511628211ULL;
+    }
+    return hash;
+}
